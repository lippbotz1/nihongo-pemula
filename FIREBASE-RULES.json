{
  "rules": {
    ".read": false,
    ".write": false,
    "licenses": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "presence": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "login_history": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "device_lock": {
      "$emailKey": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}
